# Copy to .env beside compose.yaml, fill it in, and keep it private (chmod 600). Never commit it.
# Make each password with: openssl rand -hex 24
# Letters and digits only: Compose and Grafana expand "$", and @ : / ? break a postgresql:// DSN.
AUT_PG_ADMIN_PASSWORD=
AUT_WRITER_PASSWORD=
AUT_RO_PASSWORD=
AUT_GRAFANA_ADMIN_PASSWORD=

# The IANA time zone that decides what a "day" is in every view, for example Europe/Berlin.
# Set ledger_timezone in each collector's config.toml to the same value.
AUT_TZ=

# 127.0.0.1 keeps the database and Grafana on this machine only. On a homelab, set the address
# other machines reach it on, such as its LAN or Tailscale address. Never expose it to the internet.
AUT_BIND=127.0.0.1
AUT_PG_PORT=5432
AUT_GRAFANA_PORT=3000

# How often the derived views (active time, episodes, cost) refresh, in seconds.
AUT_REFRESH_SECONDS=3600
